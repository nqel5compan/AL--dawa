# ============================================================
# Dockerfile "مضاد للنقص" — يعمل حتى لو رفع GitHub ضاع منه ملفات/فولدرات
# الفكرة: داخل هذا الملف نسخة كاملة من المشروع. وقت البناء:
#   نسخة المشروع المضمّنة = الأساس  +  ملفات الريبو فوقها (الريبو يغلب).
# أي ملف ناقص في الريبو (src أو scripts أو public أو configs ...) يُعوَّض تلقائيًا.
# ============================================================

# ---------- 0) bundle: النسخة المضمّنة ----------
FROM alpine:3.20 AS bundle
RUN mkdir -p /out /proj && : > /out/b.b64
RUN printf '%s' '' >> /out/b.b64
RUN printf '%s' '' >> /out/b.b64
RUN printf '%s' '' >> /out/b.b64
RUN printf '%s' '' >> /out/b.b64
RUN printf '%s' '' >> /out/b.b64
RUN printf '%s' '' >> /out/b.b64
RUN printf '%s' '' >> /out/b.b64
RUN base64 -d /out/b.b64 | tar xz -C /proj && rm -f /out/b.b64

# ---------- 1) source: المشروع المدموج (مضمّن + الريبو فوقه) ----------
FROM node:22-alpine AS source
WORKDIR /app
COPY --from=bundle /proj ./
COPY . .
# حماية من نهايات أسطر ويندوز (CRLF) + ضمان وجود public وscripts/migrate.sh
RUN mkdir -p public scripts \
    && [ -f scripts/migrate.sh ] || printf '#!/bin/sh\nset -e\ncd "$(dirname "$0")/.."\n./node_modules/.bin/prisma migrate deploy\n' > scripts/migrate.sh; \
    sed -i 's/\r$//' scripts/*.sh
# فحص نهائي (لن يفشل عمليًا لأن النسخة المضمّنة تغطي كل شيء)
RUN for p in package.json package-lock.json prisma/schema.prisma prisma/migrations src/app src/lib src/worker src/middleware.ts tsconfig.json next.config.ts; do \
      [ -e "$p" ] || { echo "!!! ناقص: $p"; exit 1; }; \
    done

# ---------- 2) deps: كل التبعيات من الـ lockfile ----------
FROM node:22-alpine AS deps
WORKDIR /app
# openssl مطلوب لـ Prisma على alpine
RUN apk add --no-cache libc6-compat openssl
COPY --from=source /app/package.json /app/package-lock.json ./
COPY --from=source /app/prisma ./prisma
RUN npm ci --no-audit --no-fund

# ---------- 3) builder ----------
FROM node:22-alpine AS builder
WORKDIR /app
RUN apk add --no-cache libc6-compat openssl
COPY --from=source /app ./
COPY --from=deps /app/node_modules ./node_modules
# قيم زائفة لوقت البناء فقط (لا تدخل الـ image النهائي)
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    DATABASE_URL="postgresql://build:build@localhost:5432/build" \
    REDIS_URL="redis://localhost:6379" \
    JWT_SECRET="build-time-placeholder-secret-0123456789abcdef"
RUN npx prisma generate && npm run build

# ---------- 4) runner ----------
FROM node:22-alpine AS runner
WORKDIR /app
RUN apk add --no-cache poppler-utils openssl libc6-compat \
    && addgroup -S aldawa && adduser -S aldawa -G aldawa
ENV NODE_ENV=production \
    PORT=3000 \
    HOSTNAME=0.0.0.0 \
    NEXT_TELEMETRY_DISABLED=1
# node_modules كاملة (prisma CLI + tsx للـ worker) + عميل Prisma المولَّد
COPY --from=deps /app/node_modules ./node_modules
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder /app/package.json /app/package-lock.json ./
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/public ./public
COPY --from=builder /app/prisma ./prisma
COPY --from=builder /app/src ./src
COPY --from=builder /app/scripts ./scripts
COPY --from=builder /app/tsconfig.json ./
RUN mkdir -p uploads && chown -R aldawa:aldawa /app
USER aldawa
EXPOSE 3000
CMD ["node", "server.js"]
